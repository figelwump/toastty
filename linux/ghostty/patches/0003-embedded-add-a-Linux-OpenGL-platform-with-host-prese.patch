 };
 
 pub const EnvVar = extern struct {
@@ -1504,6 +1524,50 @@ pub const CAPI = struct {
         }
     };
 
+    /// ghostty_frame_kind_e
+    const FrameKind = enum(c_int) {
+        none = 0,
+        dmabuf = 1,
+        memory = 2,
+    };
+
+    /// ghostty_frame_s
+    ///
+    /// A finished frame exported by the renderer for presentation by the
+    /// host. Only produced by renderers that export frames (OpenGL); the
+    /// host must release every taken frame with ghostty_frame_release.
+    const Frame = extern struct {
+        kind: FrameKind = .none,
+        width: u32 = 0,
+        height: u32 = 0,
+
+        /// True when row 0 is the bottom row (OpenGL origin). The host
+        /// must flip vertically when compositing.
+        flip_y: bool = false,
+
+        /// True when color values are premultiplied by alpha.
+        premultiplied: bool = true,
+
+        /// Memory frames: tightly packed RGBA8 (sRGB-encoded) pixels.
+        pixels: ?[*]const u8 = null,
+        pixels_len: usize = 0,
+        stride: u32 = 0,
+
+        /// DMA-BUF frames: DRM format, modifier and planes. The fds stay
+        /// owned by the frame and are closed by ghostty_frame_release.
+        fourcc: u32 = 0,
+        modifier: u64 = 0,
+        n_planes: u32 = 0,
+        fds: [4]c_int = .{ -1, -1, -1, -1 },
+        offsets: [4]u32 = .{ 0, 0, 0, 0 },
+        strides: [4]u32 = .{ 0, 0, 0, 0 },
+
+        /// Opaque owner of the frame's resources.
+        handle: ?*anyopaque = null,
+    };
+
+    const ExportedFrame = renderer.Renderer.ExportedFrame;
+
     const SurfaceSize = extern struct {
         columns: u16,
         rows: u16,
@@ -1960,6 +2024,101 @@ pub const CAPI = struct {
         surface.draw();
     }
 
+    /// Take the latest frame the renderer exported, if any. Returns false
+    /// (leaving `out` zeroed with kind NONE) when no new frame is pending
+    /// or the renderer does not export frames (Metal). Call this from the
+    /// host's draw/snapshot handler after a `render` action. Thread-safe.
+    export fn ghostty_surface_take_frame(
+        surface: *Surface,
+        out: *Frame,
+    ) bool {
+        out.* = .{};
+        if (comptime ExportedFrame == void) return false;
+
+        const frame = surface.core_surface.renderer.takeFrame() orelse
+            return false;
+        const alloc = global.alloc();
+        const owned = alloc.create(ExportedFrame) catch |err| {
+            log.warn("error allocating frame err={}", .{err});
+            frame.deinit();
+            return false;
+        };
+        owned.* = frame;
+
+        out.handle = owned;
+        out.flip_y = !renderer.Renderer.custom_shader_y_is_down;
+        switch (frame) {
+            .memory => |m| {
+                out.kind = .memory;
+                out.width = m.width;
+                out.height = m.height;
+                out.premultiplied = true;
+                out.pixels = m.pixels.ptr;
+                out.pixels_len = m.pixels.len;
+                out.stride = m.width * 4;
+            },
+
+            .dmabuf => |d| {
+                out.kind = .dmabuf;
+                out.width = d.width;
+                out.height = d.height;
+                out.premultiplied = d.premultiplied;
+                out.fourcc = d.fourcc;
+                out.modifier = d.modifier;
+                out.n_planes = d.planes.count;
+                for (0..d.planes.count) |i| {
+                    out.fds[i] = d.planes.fds[i];
+                    out.offsets[i] = @intCast(d.planes.offsets[i]);
+                    out.strides[i] = @intCast(d.planes.strides[i]);
+                }
+            },
+        }
+
+        return true;
+    }
+
+    /// Release a frame returned by ghostty_surface_take_frame: frees the
+    /// pixel memory or closes the DMA-BUF fds. Safe to call on any thread
+    /// and after the surface has been freed. Resets `frame` to NONE.
+    export fn ghostty_frame_release(frame: *Frame) void {
+        if (comptime ExportedFrame == void) return;
+        if (frame.handle) |h| {
+            const owned: *ExportedFrame = @ptrCast(@alignCast(h));
+            owned.deinit();
+            global.alloc().destroy(owned);
+        }
+        frame.* = .{};
+    }
+
+    /// Report whether the host can present the frames the renderer
+    /// exports (ghostty_action_renderer_health_e). Report UNHEALTHY when
+    /// a DMA-BUF frame could not be imported (or the host has no GPU
+    /// compositor, e.g. GDK Broadway) so the renderer switches to CPU
+    /// memory frames. Mirrors the GTK apprt.
+    export fn ghostty_surface_set_presentation_health(
+        surface: *Surface,
+        health: c_int,
+    ) void {
+        const h = std.enums.fromInt(renderer.Health, health) orelse return;
+        surface.core_surface.reportPresentationHealth(h);
+    }
+
+    /// Tell the renderer whether the host's display for this surface is
+    /// realized. While unrealized the renderer releases GPU resources and
+    /// stops drawing. Surfaces start realized.
+    export fn ghostty_surface_set_display_realized(
+        surface: *Surface,
+        realized: bool,
+    ) void {
+        if (realized) {
+            surface.core_surface.displayRealized() catch |err| {
+                log.warn("error realizing display err={}", .{err});
+            };
+        } else {
+            surface.core_surface.displayUnrealized();
+        }
+    }
+
     /// Update the size of a surface. This will trigger resize notifications
     /// to the pty and the renderer.
     export fn ghostty_surface_set_size(surface: *Surface, w: u32, h: u32) void {
