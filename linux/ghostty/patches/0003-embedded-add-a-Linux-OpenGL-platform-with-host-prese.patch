From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Toastty Linux Port <farazrkhan@gmail.com>
Date: Tue, 20 Oct 2026 12:16:07 -0700
Subject: [PATCH 3/6] embedded: add a Linux/OpenGL platform with host-presented
 frames

The embedded apprt only accepted macOS and iOS surfaces. Add
GHOSTTY_PLATFORM_LINUX for non-Darwin targets. As in the GTK apprt, the
OpenGL renderer renders on its own thread into a surfaceless EGL
framebuffer and exports each finished frame as a DMA-BUF or a CPU pixel
buffer; the host is told to redraw through the existing render action.

New embedder API:
- ghostty_surface_take_frame / ghostty_frame_release: pull the latest
  exported frame (ghostty_frame_s) from the host's draw handler and
  release it once the compositor is done with it.
- ghostty_surface_set_presentation_health: report that DMA-BUF frames
  cannot be imported so the renderer falls back to CPU frames.
- ghostty_surface_set_display_realized: release or rebuild GPU
  resources when the host widget is unrealized or realized.

diff --git a/include/ghostty.h b/include/ghostty.h
index a11c95119..e527d83cb 100644
--- a/include/ghostty.h
+++ b/include/ghostty.h
@@ -70,6 +70,7 @@ typedef enum {
   GHOSTTY_PLATFORM_INVALID,
   GHOSTTY_PLATFORM_MACOS,
   GHOSTTY_PLATFORM_IOS,
+  GHOSTTY_PLATFORM_LINUX,
 } ghostty_platform_e;
 
 typedef enum {
@@ -494,9 +495,18 @@ typedef struct {
   void* uiview;
 } ghostty_platform_ios_s;
 
+// Linux/OpenGL: the renderer draws on its own thread into an offscreen
+// (surfaceless EGL) framebuffer and exports each finished frame. The host
+// is notified with GHOSTTY_ACTION_RENDER and presents frames it pulls with
+// ghostty_surface_take_frame.
+typedef struct {
+  void* reserved;  // must be NULL
+} ghostty_platform_linux_s;
+
 typedef union {
   ghostty_platform_macos_s macos;
   ghostty_platform_ios_s ios;
+  ghostty_platform_linux_s opengl;  // GHOSTTY_PLATFORM_LINUX (`linux` is a GNU C macro)
 } ghostty_platform_u;
 
 typedef enum {
@@ -520,6 +530,36 @@ typedef struct {
   ghostty_surface_context_e context;
 } ghostty_surface_config_s;
 
+// Frames exported by renderers that do not draw into a host view
+// (OpenGL on Linux). See ghostty_surface_take_frame.
+typedef enum {
+  GHOSTTY_FRAME_NONE = 0,
+  GHOSTTY_FRAME_DMABUF = 1,
+  GHOSTTY_FRAME_MEMORY = 2,
+} ghostty_frame_kind_e;
+
+typedef struct {
+  ghostty_frame_kind_e kind;
+  uint32_t width;
+  uint32_t height;
+  // Row 0 is the bottom row (OpenGL origin); flip when compositing.
+  bool flip_y;
+  bool premultiplied;
+  // GHOSTTY_FRAME_MEMORY: tightly packed RGBA8 (sRGB-encoded) pixels.
+  const uint8_t* pixels;
+  size_t pixels_len;
+  uint32_t stride;
+  // GHOSTTY_FRAME_DMABUF: the fds remain owned by the frame and are
+  // closed by ghostty_frame_release.
+  uint32_t fourcc;
+  uint64_t modifier;
+  uint32_t n_planes;
+  int fds[4];
+  uint32_t offsets[4];
+  uint32_t strides[4];
+  void* handle;
+} ghostty_frame_s;
+
 typedef struct {
   uint16_t columns;
   uint16_t rows;
@@ -1236,6 +1276,13 @@ GHOSTTY_API bool ghostty_surface_is_at_prompt(ghostty_surface_t);
 GHOSTTY_API bool ghostty_surface_process_exited(ghostty_surface_t);
 GHOSTTY_API void ghostty_surface_refresh(ghostty_surface_t);
 GHOSTTY_API void ghostty_surface_draw(ghostty_surface_t);
+// Linux/OpenGL frame presentation. See ghostty_frame_s.
+GHOSTTY_API bool ghostty_surface_take_frame(ghostty_surface_t, ghostty_frame_s*);
+GHOSTTY_API void ghostty_frame_release(ghostty_frame_s*);
+GHOSTTY_API void ghostty_surface_set_presentation_health(
+    ghostty_surface_t,
+    ghostty_action_renderer_health_e);
+GHOSTTY_API void ghostty_surface_set_display_realized(ghostty_surface_t, bool);
 GHOSTTY_API void ghostty_surface_set_content_scale(ghostty_surface_t, double, double);
 GHOSTTY_API void ghostty_surface_set_focus(ghostty_surface_t, bool);
 GHOSTTY_API void ghostty_surface_set_occlusion(ghostty_surface_t, bool);
diff --git a/src/apprt/embedded.zig b/src/apprt/embedded.zig
index 10c34de5a..9444c6220 100644
